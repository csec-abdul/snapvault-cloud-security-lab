# Copy this file to `.env` before running the hardened lab, then replace every
# CHANGE_ME value with your own. Generate strong random values, e.g.:
#   openssl rand -base64 24
# and a bcrypt hash for the admin password (note: in docker-compose each `$` is doubled to `$$`).
MINIO_ROOT_USER=svadmin
MINIO_ROOT_PASSWORD=CHANGE_ME
APP_ACCESS_KEY=snapvault-app
APP_SECRET_KEY=CHANGE_ME
APP_ADMIN_USER=admin
APP_ADMIN_PASS_HASH=CHANGE_ME
